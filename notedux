CONFIG_FILE="$HOME/.notedux.conf"
API="https://notedux.com/api/note"

# -------------------------
# Platform / dependency check
# -------------------------

# Detects OS and picks a clipboard command. Exits with a helpful message
# if something required is missing.
check_compatibility() {

    OS_NAME="$(uname -s)"

    case "$OS_NAME" in
        Darwin)
            PLATFORM="mac"
            ;;
        Linux)
            PLATFORM="linux"
            ;;
        *)
            echo "Error: unsupported operating system ($OS_NAME)."
            echo "Notedux CLI supports macOS and Linux only."
            exit 1
            ;;
    esac

    # curl is required everywhere
    if ! command -v curl &>/dev/null; then
        echo "Error: 'curl' is required but not installed."
        case "$PLATFORM" in
            mac)
                echo "Install it with: brew install curl"
                ;;
            linux)
                echo "Install it with your package manager, e.g.:"
                echo "  sudo apt install curl      (Debian/Ubuntu)"
                echo "  sudo dnf install curl      (Fedora)"
                echo "  sudo pacman -S curl        (Arch)"
                ;;
        esac
        exit 1
    fi

    # Clipboard tool: pick the first available one per platform.
    CLIPBOARD_CMD=""

    if [ "$PLATFORM" = "mac" ]; then
        if command -v pbcopy &>/dev/null; then
            CLIPBOARD_CMD="pbcopy"
        fi
    else
        # Linux: proveri da li X11 radi
        if [ -n "$DISPLAY" ] && [ "$DISPLAY" != ":0" ]; then
            # X11 je aktivan
            if command -v xclip &>/dev/null; then
                CLIPBOARD_CMD="xclip -selection clipboard"
            elif command -v xsel &>/dev/null; then
                CLIPBOARD_CMD="xsel --clipboard --input"
            elif command -v wl-copy &>/dev/null; then
                CLIPBOARD_CMD="wl-copy"
            fi
        elif command -v wl-copy &>/dev/null && [ -n "$WAYLAND_DISPLAY" ]; then
            # Wayland
            CLIPBOARD_CMD="wl-copy"
        fi
        # Ako nema X11 ili Wayland, CLIPBOARD_CMD ostaje prazan
    fi

    # No clipboard tool found - warn once, don't block usage.
    if [ -z "$CLIPBOARD_CMD" ]; then
        CLIPBOARD_WARNED=1
        if [ "$PLATFORM" = "mac" ]; then
            echo "Warning: 'pbcopy' not found. Links will not be copied to clipboard."
        else
            if [ -z "$DISPLAY" ]; then
                echo "Info: No X11 display detected. Clipboard disabled."
            else
                echo "Warning: no clipboard tool found (xclip, xsel, or wl-copy)."
                echo "Links will not be copied to clipboard. Install one with, e.g.:"
                echo "  sudo apt install xclip     (Debian/Ubuntu, X11)"
                echo "  sudo dnf install xclip     (Fedora, X11)"
                echo "  sudo pacman -S xclip       (Arch, X11)"
                echo "  sudo apt install wl-clipboard   (Wayland)"
            fi
        fi
    fi
}
# Copies stdin to the clipboard using whatever tool was detected.
# Silently does nothing if no clipboard tool is available.
copy_to_clipboard() {
    if [ -n "$CLIPBOARD_CMD" ]; then
        eval "$CLIPBOARD_CMD"
    else
        cat >/dev/null
    fi
}


show_help() {
cat <<EOF

